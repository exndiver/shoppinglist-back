{
  "info": {
    "name": "Shopping List Backend",
    "description": "Тесты HTTP API (см. docs/api.md).\n\n**Переменные** (Edit collection → Variables): `baseUrl`, `ownerId`, фиксированные UUID сущностей — при повторном прогоне меняй UUID или чисти БД.\n\n**Collection Runner:** выбери коллекцию → Run — папки идут в порядке сценария: Health → создание товаров → магазины → офферы/цены → чтение товаров → списки → идентичности → merge → негативные тесты.\n\nЛишние поля в JSON → 400 (`DisallowUnknownFields`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "ownerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "goodId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "goodId2", "value": "33333333-3333-3333-3333-333333333333" },
    { "key": "storeId", "value": "44444444-4444-4444-4444-444444444444" },
    { "key": "offerId", "value": "55555555-5555-5555-5555-555555555555" },
    { "key": "priceRecordId", "value": "66666666-6666-6666-6666-666666666666" },
    { "key": "priceRecordId2", "value": "66666666-6666-6666-6666-666666666667" },
    { "key": "listId", "value": "77777777-7777-7777-7777-777777777777" },
    { "key": "listItemId", "value": "88888888-8888-8888-8888-888888888888" },
    { "key": "categoryId", "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" }
  ],
  "item": [
    {
      "name": "Health (без авторизации)",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Категории",
      "item": [
        {
          "name": "POST /categories — upsert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{categoryId}}\",\n  \"name\": \"Groceries\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "GET /categories?q=groc",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/categories?q=groc"
          }
        },
        {
          "name": "GET /categories?updated_since",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/categories?updated_since=1970-01-01T00:00:00Z"
          }
        }
      ]
    },
    {
      "name": "Товары — создание",
      "item": [
        {
          "name": "POST /goods — upsert A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-Device-Id", "value": "postman", "type": "text", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{goodId}}\",\n  \"name\": \"Молоко 3.2%\",\n  \"category_id\": \"{{categoryId}}\"\n}"
            },
            "url": "{{baseUrl}}/goods"
          }
        },
        {
          "name": "POST /goods — upsert B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{goodId2}}\",\n  \"name\": \"Кефир\"\n}"
            },
            "url": "{{baseUrl}}/goods"
          }
        }
      ]
    },
    {
      "name": "Магазины",
      "item": [
        {
          "name": "POST /stores — upsert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{storeId}}\",\n  \"name\": \"Пятёрочка у дома\"\n}"
            },
            "url": "{{baseUrl}}/stores"
          }
        },
        {
          "name": "GET /stores?q=пят",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/stores?q=пят"
          }
        }
      ]
    },
    {
      "name": "Товары — чтение",
      "item": [
        {
          "name": "GET /goods?q=мол",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/goods?q=мол"
          }
        },
        {
          "name": "GET /goods/{id}",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/goods/{{goodId}}"
          }
        },
        {
          "name": "GET /goods/{id}/merge-candidates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/goods/{{goodId}}/merge-candidates?q=кеф"
          }
        },
        {
          "name": "GET /goods/{id}/identities",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/goods/{{goodId}}/identities"
          }
        },
        {
          "name": "GET /goods/{id}/offers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/goods/{{goodId}}/offers"
          }
        }
      ]
    },
    {
      "name": "Офферы и цены",
      "item": [
        {
          "name": "POST /offers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{offerId}}\",\n  \"good_id\": \"{{goodId}}\",\n  \"store_id\": \"{{storeId}}\"\n}"
            },
            "url": "{{baseUrl}}/offers"
          }
        },
        {
          "name": "POST /price-records",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{priceRecordId}}\",\n  \"offer_id\": \"{{offerId}}\",\n  \"price\": 89.9,\n  \"pack_size\": 1,\n  \"unit\": \"pcs\",\n  \"recorded_at\": \"2026-05-03T12:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/price-records"
          }
        },
        {
          "name": "POST /price-records (recorded_at по умолчанию)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{priceRecordId2}}\",\n  \"offer_id\": \"{{offerId}}\",\n  \"price\": 79.9\n}"
            },
            "url": "{{baseUrl}}/price-records"
          }
        },
        {
          "name": "GET /offers/{id}/prices",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/offers/{{offerId}}/prices"
          }
        },
        {
          "name": "GET /offers/{id}/price/latest",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/offers/{{offerId}}/price/latest"
          }
        }
      ]
    },
    {
      "name": "Списки и позиции",
      "item": [
        {
          "name": "POST /lists — upsert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{listId}}\",\n  \"name\": \"На выходные\"\n}"
            },
            "url": "{{baseUrl}}/lists"
          }
        },
        {
          "name": "GET /lists",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/lists"
          }
        },
        {
          "name": "GET /lists/{id}",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/lists/{{listId}}"
          }
        },
        {
          "name": "POST /list-items",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{listItemId}}\",\n  \"list_id\": \"{{listId}}\",\n  \"good_id\": \"{{goodId}}\",\n  \"offer_id\": \"{{offerId}}\",\n  \"quantity\": 2,\n  \"price_snapshot\": 89.9\n}"
            },
            "url": "{{baseUrl}}/list-items"
          }
        },
        {
          "name": "PATCH /list-items/{id} — quantity + is_purchased",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3,\n  \"is_purchased\": true\n}"
            },
            "url": "{{baseUrl}}/list-items/{{listItemId}}"
          }
        },
        {
          "name": "PATCH /list-items/{id} — снять offer_id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offer_id\": null\n}"
            },
            "url": "{{baseUrl}}/list-items/{{listItemId}}"
          }
        }
      ]
    },
    {
      "name": "Идентичности товара",
      "item": [
        {
          "name": "GET /goods/{id}/identities (после POST)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/goods/{{goodId}}/identities"
          }
        },
        {
          "name": "POST /good-identities",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"good_id\": \"{{goodId}}\",\n  \"external_id\": \"sku-12345\",\n  \"source\": \"erp\"\n}"
            },
            "url": "{{baseUrl}}/good-identities"
          }
        }
      ]
    },
    {
      "name": "Sync (incremental)",
      "item": [
        {
          "name": "POST /sync/batch?since",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/sync/batch?since=1970-01-01T00:00:00Z"
          }
        },
        {
          "name": "GET /price-records?since",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/price-records?since=1970-01-01T00:00:00Z"
          }
        }
      ]
    },
    {
      "name": "Merge товаров (в конце сценария)",
      "item": [
        {
          "name": "POST /goods/merge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_good_id\": \"{{goodId2}}\",\n  \"target_good_id\": \"{{goodId}}\"\n}"
            },
            "url": "{{baseUrl}}/goods/merge"
          }
        }
      ]
    },
    {
      "name": "Негативные примеры",
      "item": [
        {
          "name": "GET /goods без Authorization",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/goods"
          }
        },
        {
          "name": "POST /goods — лишнее поле в JSON",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerId}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{goodId}}\",\n  \"name\": \"Тест\",\n  \"extra\": true\n}"
            },
            "url": "{{baseUrl}}/goods"
          }
        },
        {
          "name": "POST /goods — неверный Bearer (не UUID)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer not-a-uuid", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{goodId}}\",\n  \"name\": \"Тест\"\n}"
            },
            "url": "{{baseUrl}}/goods"
          }
        }
      ]
    }
  ]
}
