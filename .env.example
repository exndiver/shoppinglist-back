PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_USER=shopping
DB_PASSWORD=shopping
DB_NAME=shopping
DB_SSLMODE=disable

# Если нужно — можно задать напрямую, тогда остальные DB_* игнорируются миграциями/коннектом
# DB_URL=postgres://shopping:shopping@postgres:5432/shopping?sslmode=disable

RUN_MIGRATIONS=true
# локально из корня репо: file://migrations; в Docker-образе (scratch): file:///app/migrations
MIGRATIONS_PATH=file://migrations

SHUTDOWN_TIMEOUT=10s

# Логи: JSON в файл (путь от рабочей директории процесса; в Docker см. volume ./logs).
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=shopping-backend
LOG_FILE=logs/logs.log
# Запросы медленнее этого порога пишутся уровнем warn (0 отключает)
LOG_SLOW_REQUEST=1s
# Необязательно: попадёт в поле service.version в логах
# APP_VERSION=0.0.0

