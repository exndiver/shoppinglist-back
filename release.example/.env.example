# Скопируй в release на сервере:
#   mkdir -p release && cp release.example/docker-compose.yml release.example/.env.example release/
#   mv release/.env.example release/.env
# Затем: cd release && docker compose up -d

APP_IMAGE=ghcr.io/exndiver/shoppinglist-back:latest

SHOPPING_BIND=127.0.0.1
SHOPPING_HOST_PORT=38080

POSTGRES_DB=shopping
POSTGRES_USER=shopping
# openssl rand -hex 32
POSTGRES_PASSWORD=

PGDATA_HOST_PATH=./data/postgres
LOGS_HOST_PATH=./data/logs

RUN_MIGRATIONS=true
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=shopping-backend
LOG_SLOW_REQUEST=1s
